const vc={on:false,muted:false,stream:null,ctx:null,pcs:new Map(),room:null,off:null,me:null,cool:{}};
const ICE={iceServers:[{urls:'stun:stun.l.google.com:19302'}]};
function vcSig(to,t,s){if(mp.room)mp.room.emit('vs',{to,t,s}).catch(()=>{});}
function iceDone(pc){return new Promise(r=>{if(pc.iceGatheringState==='complete')return r();const f=()=>{if(pc.iceGatheringState==='complete'){pc.removeEventListener('icegatheringstatechange',f);r();}};pc.addEventListener('icegatheringstatechange',f);setTimeout(r,2500);});}
function vcPC(id){
  const pc=new RTCPeerConnection(ICE),rec={pc,gain:null,t0:performance.now()};vc.pcs.set(id,rec);
  vc.stream.getTracks().forEach(t=>pc.addTrack(t,vc.stream));
  pc.ontrack=e=>{const s=e.streams[0];if(!s||rec.gain)return;const el=new Audio();el.srcObject=s;el.muted=true;el.play().catch(()=>{});rec.el=el;
    if(vc.ctx.resume)vc.ctx.resume();const src=vc.ctx.createMediaStreamSource(s),g=vc.ctx.createGain();g.gain.value=0;src.connect(g);g.connect(vc.ctx.destination);rec.gain=g;const an=vc.ctx.createAnalyser();an.fftSize=256;src.connect(an);rec.an=an;};
  pc.onconnectionstatechange=()=>{if(pc.connectionState==='failed'||pc.connectionState==='closed')vcDrop(id);};
  return rec;}
function vcDrop(id){const r=vc.pcs.get(id);if(!r)return;try{r.pc.close();}catch(_){}vc.pcs.delete(id);}
function vcReset(){[...vc.pcs.keys()].forEach(vcDrop);if(vc.off){try{vc.off();}catch(_){}vc.off=null;}}
async function vcCall(id){try{const {pc}=vcPC(id);await pc.setLocalDescription(await pc.createOffer());await iceDone(pc);vcSig(id,'o',pc.localDescription.sdp);}catch(_){vcDrop(id);}}
async function vcMsg(m){const d=m.data;if(!d||m.sameTab||d.to!==vc.me||!vc.on||typeof d.s!=='string'||d.s.length>3800)return;
  try{
    if(d.t==='o'){vcDrop(m.peer);const {pc}=vcPC(m.peer);await pc.setRemoteDescription({type:'offer',sdp:d.s});await pc.setLocalDescription(await pc.createAnswer());await iceDone(pc);vcSig(m.peer,'a',pc.localDescription.sdp);}
    else if(d.t==='a'){const r=vc.pcs.get(m.peer);if(r&&r.pc.signalingState==='have-local-offer')await r.pc.setRemoteDescription({type:'answer',sdp:d.s});}
  }catch(_){vcDrop(m.peer);}}
function vcTick(ps){
  if(!vc.on)return;
  if(vc.room!==mp.room){vcReset();vc.room=mp.room;try{vc.off=mp.room.on('vs',vcMsg);}catch(_){}}
  const me=ps.find(q=>q.sameTab);vc.me=me?me.peer:null;if(!vc.me)return;
  const now=performance.now();
  for(const q of ps){if(q.sameTab||q.kind==='agent'||q.presence.v!==1)continue;
    let r=vc.pcs.get(q.peer);
    if(r&&r.pc.connectionState!=='connected'&&now-r.t0>15000){vcDrop(q.peer);r=null;}
    if(!r&&vc.me<q.peer&&(vc.cool[q.peer]||0)<now){vc.cool[q.peer]=now+8000;vcCall(q.peer);}
    if(r&&r.gain){const d=q.presence,dist=Math.hypot((d.x||0)-P.x,(d.z||0)-P.z);r.gain.gain.value=d.m===mapName?Math.pow(Math.max(0,1-dist/70),1.5):0;}
  }
  for(const id of [...vc.pcs.keys()]){const q=ps.find(x=>x.peer===id);if(!q||q.presence.v===0)vcDrop(id);}
}
function vcUI(){const b=$('vcb');b.classList.toggle('on',vc.on&&!vc.muted);b.classList.toggle('mute',vc.on&&vc.muted);b.textContent=vc.on&&vc.muted?'🔇':'🎤';}
function vcLeave(){vc.on=false;vc.muted=false;if(vc.stream){vc.stream.getTracks().forEach(t=>t.stop());vc.stream=null;}vcReset();vc.room=null;if(vc.ctx){try{vc.ctx.close();}catch(_){}vc.ctx=null;}toast('Voice chat off');vcUI();}
async function vcToggle(){
  if(!vc.on){
    if(!mp.room){toast('Voice chat needs a multiplayer server');return;}
    if(!navigator.mediaDevices||!navigator.mediaDevices.getUserMedia){toast('Microphone isn’t available here');return;}
    try{vc.stream=await navigator.mediaDevices.getUserMedia({audio:{echoCancellation:true,noiseSuppression:true,autoGainControl:true}});}
    catch(e){toast(e&&e.name==='NotAllowedError'?'Mic blocked. Allow microphone access for this page.':'Can’t use the microphone here');return;}
    vc.ctx=new (window.AudioContext||window.webkitAudioContext)();vc.on=true;vc.muted=false;vc.an=vc.ctx.createAnalyser();vc.an.fftSize=256;vc.ctx.createMediaStreamSource(vc.stream).connect(vc.an);toast('Voice chat on – click again to mute');
  }else if(!vc.muted){vc.muted=true;vc.stream.getAudioTracks().forEach(t=>t.enabled=false);toast('Mic muted – click again to unmute');}
  else{vc.muted=false;vc.stream.getAudioTracks().forEach(t=>t.enabled=true);toast('Mic on');}
  vcUI();
}
