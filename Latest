  (btns||[]).concat([['Close',()=>0]]).forEach(([l,f])=>{const e=document.createElement('button');e.textContent=l;e.onclick=()=>{if(!f())bfd.classList.remove('open');};b.appendChild(e);});bfd.classList.add('open');}
const SWD=[[8,1500],[9,3500],[10,6000],[7,9000],[4,9000],[3,15000]];
function talk(n){
  if(n.kind==='quest'){
    if(BF.q){dlg('Quest Giver','Current quest: '+BF.q.t+' ('+BF.q.k+'/'+BF.q.n+'). Reward: '+fmt(BF.q.xp)+' XP and ₿'+fmt(BF.q.bel)+'.',[['Abandon quest',()=>{BF.q=null;bfSave();}]]);return;}
    const q=QS.filter(x=>x.npc===n.island&&BF.lvl>=x.lvl).sort((a,b)=>b.lvl-a.lvl)[0];
    if(!q){const nx=QS.filter(x=>x.npc===n.island).sort((a,b)=>a.lvl-b.lvl)[0];dlg('Quest Giver',nx?'Come back at level '+nx.lvl+'.':'No quests here.');return;}
    dlg('Quest Giver',q.t+'. Reward: '+fmt(q.xp)+' XP and ₿'+fmt(q.bel)+'.',[['Accept',()=>{BF.q={...q,k:0};bfSave();toast('Quest accepted: '+q.t);}]]);}
  else if(n.kind==='fruit'){const price=BF.rolled?1500:0;
    dlg('Fruit Dealer',(BF.rolled?'A random Devil Fruit costs ₿1,500.':'Your first Devil Fruit is free!')+'  You have ₿'+fmt(BF.beli)+'.  Fruit equipped: '+(BF.fruit>=0?FR[BF.fruit][0]:'none'),
      [['Roll a fruit (₿'+fmt(price)+')',()=>{if(BF.beli<price){toast('Not enough Beli');return;}BF.beli-=price;BF.rolled++;giveFruit(rollFruit(),'You rolled');bfSave();}]].concat(BF.owned.map(i=>['Eat '+FR[i][1]+' '+FR[i][0],()=>{BF.fruit=i;bfSave();toast('Equipped the '+FR[i][0]+' Fruit');}])));}
  else dlg('Sword Dealer','Buy a sword for your hotbar. You have ₿'+fmt(BF.beli)+'.',SWD.map(([id,pr])=>[GEARS[id][1]+' '+GEARS[id][0]+' ₿'+fmt(pr),()=>{if(BF.beli<pr){toast('Not enough Beli');return;}BF.beli-=pr;addHot(id);bfSave();toast('Bought '+GEARS[id][0]);}]));}
const nearNpc=()=>NPCS.find(n=>n.map===mapName&&Math.hypot(n.x-P.x,n.z-P.z)<9);
function npcClick(){const hs=rc.intersectObjects(NPCS.filter(n=>n.map===mapName).map(n=>n.g),true);if(!hs.length)return false;const n=NPCS.find(q=>{let o=hs[0].object;while(o){if(o===q.g)return true;o=o.parent;}return false;});if(n&&Math.hypot(n.x-P.x,n.z-P.z)<16){talk(n);return true;}return false;}
// ---- HUD ----
const bfh=document.createElement('div');bfh.id='bfh';bfh.className='ui';bfh.innerHTML=`<div id='bfl'></div><div class='xb'><i id='bfxp'></i></div><div id='bfq' style='font-size:12px;opacity:.85'></div><div id='bfp' style='font-size:12px;color:#ffd23a'></div>`;document.body.appendChild(bfh);
const bfm=document.createElement('div');bfm.id='bfm';bfm.className='ui';bfm.innerHTML=['Z','X','C','V'].map((k,i)=>`<div class='mv' data-i='${i}'><b>${k}</b><span></span><u></u></div>`).join('');document.body.appendChild(bfm);
bfm.addEventListener('click',e=>{const m=e.target.closest('.mv');if(m)bfMove(+m.dataset.i);});
addEventListener('keydown',e=>{if(!playing||typing||e.repeat)return;const k=e.code;
  if(k==='KeyZ')bfMove(0);else if(k==='KeyX')bfMove(1);else if(k==='KeyC')bfMove(2);else if(k==='KeyV')bfMove(3);
  else if(k==='KeyE'){const n=nearNpc();if(n)talk(n);}});
let bfPrev='';
function bfTick(t,dt){
  const on=playing&&mapName==='bf';bfh.style.display=on?'block':'none';
  NPCS.forEach(n=>{n.g.visible=n.map===mapName;n.s.position.y=9+Math.sin(t*3)*.3;});
  if(mapName!==bfPrev){bfPrev=mapName;if(mapName==='bf'&&playing)dlg('Welcome to the Sea!','Talk to the Fruit Dealer for a free Devil Fruit, then take a quest from the Quest Giver. Press Z X C V to use fruit moves, E to talk to people, and click to attack. Islands to the north and east have tougher enemies.');}
  const f=BF.fruit>=0?FR[BF.fruit]:null;bfm.style.display=on&&f?'flex':'none';
  if(!on)return;
  const n=nearNpc();$('bfp').textContent=n?'Press E to talk to '+(n.kind==='quest'?'the Quest Giver':n.kind==='fruit'?'the Fruit Dealer':'the Sword Dealer'):'';
  if(bfd.classList.contains('open')&&!n)bfd.classList.remove('open');
  $('bfl').textContent='Lv. '+BF.lvl+'   ₿ '+fmt(BF.beli)+(f?'   '+f[1]+' '+f[0]:'');$('bfxp').style.width=Math.min(100,BF.xp/need(BF.lvl)*100)+'%';
  $('bfq').textContent=BF.q?BF.q.t+' ('+BF.q.k+'/'+BF.q.n+')':'No active quest';
  if(f){const now=nowS();bfm.querySelectorAll('.mv').forEach((el,i)=>{const lock=BF.lvl<GATE[i],r=Math.max(0,((gm.cd['m'+i]||0)-now)/(gm.cdm['m'+i]||1));el.querySelector('span').textContent=lock?'🔒 Lv.'+GATE[i]:f[4][i][0];el.querySelector('u').style.height=Math.min(100,r*100)+'%';el.style.opacity=lock?.5:1;});}}

// ---- cursor: white arrow normally, black arrow over clickable things in the 3D view ----
let curT=0;
document.addEventListener('mousemove',e=>{if(e.target!==cv||curT)return;curT=requestAnimationFrame(()=>{curT=0;let hov=false;if(playing&&!st){const R=cv.getBoundingClientRect();mv.set((e.clientX-R.left)/R.width*2-1,-((e.clientY-R.top)/R.height)*2+1);rc.camera=cam;rc.setFromCamera(mv,cam);hov=rc.intersectObject(mic).length>0||rc.intersectObjects(NPCS.filter(n=>n.map===mapName).map(n=>n.g),true).length>0;}cv.classList.toggle('hov',hov);});});

