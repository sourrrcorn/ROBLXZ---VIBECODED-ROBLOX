// ---- multiplayer: join codes ----
const mp={room:null,lobby:null,code:'',R:new Map(),last:0,lb:0,avs:'',adopt:false};
function setMps(s){$('mps').textContent=s;}
function mpUI(){$('mpl').style.display=mp.room&&mp.room!==mp.lobby?'block':'none';if(!mp.room)$('mpm').textContent='';}
function cleanAv(a){a=a||{};const n=(v,d)=>Number.isFinite(+v)?Math.max(0,Math.min(0xffffff,+v|0)):d;return{head:n(a.head,0xf5cd30),torso:n(a.torso,0x0d69ac),arms:n(a.arms,0xf5cd30),legs:n(a.legs,0xa4bd47),face:[0,1,2,3].includes(a.face)?a.face:0,hat:[0,1,2,3].includes(a.hat)?a.hat:0};}
function drawFace(g,f){g.clearRect(0,0,64,64);g.fillStyle='#111';g.strokeStyle='#111';g.lineWidth=3;const arc=(x,y,r,a,b)=>{g.beginPath();g.arc(x,y,r,a,b);g.stroke();};
  if(f===1){g.fillRect(8,18,48,12);arc(32,36,12,.3,Math.PI-.3);}
  else if(f===2){g.fillRect(17,26,7,8);g.fillRect(40,26,7,8);g.beginPath();g.moveTo(12,15);g.lineTo(26,23);g.moveTo(52,15);g.lineTo(38,23);g.stroke();arc(32,52,11,Math.PI+.4,Math.PI*2-.4);}
  else if(f===3){g.fillStyle='#fff';[[20,26,10],[43,28,7]].forEach(([x,y,r])=>{g.beginPath();g.arc(x,y,r,0,7);g.fill();g.stroke();});g.fillStyle='#111';g.fillRect(22,28,4,4);g.fillRect(40,30,4,4);arc(32,42,10,.2,Math.PI-.2);g.fillStyle='#e05a7a';g.fillRect(36,48,8,9);}
  else{g.fillRect(18,20,6,10);g.fillRect(40,20,6,10);arc(32,34,13,.25,Math.PI-.25);}}
function bubbleSprite(txt){
  const c=document.createElement('canvas'),g=c.getContext('2d');c.width=512;g.font='bold 34px Arial';const lines=[];let cur='';
  for(const w of txt.split(' ')){const tt=cur?cur+' '+w:w;if(g.measureText(tt).width>440&&cur){lines.push(cur);cur=w;}else cur=tt;}
  lines.push(cur);const h=lines.length*44+30;c.height=h+30;g.font='bold 34px Arial';g.fillStyle='#fff';g.strokeStyle='#222';g.lineWidth=5;
  g.beginPath();g.moveTo(28,6);g.arcTo(506,6,506,h+6,22);g.arcTo(506,h+6,6,h+6,22);g.arcTo(6,h+6,6,6,22);g.arcTo(6,6,506,6,22);g.closePath();g.fill();g.stroke();
  g.beginPath();g.moveTo(238,h+8);g.lineTo(256,h+26);g.lineTo(274,h+8);g.fill();g.stroke();g.fillRect(240,h+3,32,8);
  g.fillStyle='#111';g.textAlign='center';lines.forEach((l,i)=>g.fillText(l,256,50+i*44));
  const sp=new THREE.Sprite(new THREE.SpriteMaterial({map:new THREE.CanvasTexture(c),transparent:true,depthTest:false}));sp.scale.set(7,7*c.height/512,1);return sp;}
function mkAvatar(a,name){
  const g=new THREE.Group(),M=c=>new THREE.MeshLambertMaterial({color:c});
  const bx=(w,h,d,c,x,y,z,p)=>{const m=new THREE.Mesh(new THREE.BoxGeometry(w,h,d),M(c));m.position.set(x,y,z);m.castShadow=true;(p||g).add(m);};
  const limb=(x,y,c)=>{const p=new THREE.Group();p.position.set(x,y,0);bx(1,2,1,c,0,-1,0,p);g.add(p);return p;};
  bx(2,2,1,a.torso,0,3,0);
  const hd=new THREE.Mesh(new THREE.CylinderGeometry(.62,.62,1.1,28),M(a.head));hd.position.y=4.55;hd.castShadow=true;g.add(hd);
  const fc2=document.createElement('canvas');fc2.width=fc2.height=64;drawFace(fc2.getContext('2d'),a.face);
  const fm=new THREE.Mesh(new THREE.PlaneGeometry(1.05,1.05),new THREE.MeshBasicMaterial({map:new THREE.CanvasTexture(fc2),transparent:true}));fm.position.z=.625;hd.add(fm);
  g.aL=limb(-1.5,4,a.arms);g.aR=limb(1.5,4,a.arms);g.lL=limb(-.5,2,a.legs);g.lR=limb(.5,2,a.legs);
  const h=new THREE.Group();h.position.y=5.1;g.add(h);const hb=(w,hh,d,c,x,y,z)=>bx(w,hh,d,c,x,y,z,h);
  if(a.hat===1){hb(1.3,.45,1.3,0xc4281c,0,.22,0);hb(1.3,.1,.6,0xc4281c,0,.05,.85);}
  if(a.hat===2){hb(1.9,.12,1.9,0x111111,0,.06,0);hb(1.2,1.2,1.2,0x111111,0,.7,0);hb(1.22,.25,1.22,0xc4281c,0,.3,0);}
  if(a.hat===3){hb(1.3,.5,1.3,0xffd23a,0,.25,0);[[-.5,-.5],[.5,-.5],[-.5,.5],[.5,.5]].forEach(([x,z])=>hb(.25,.4,.25,0xffd23a,x,.7,z));}
  const nc=document.createElement('canvas');nc.width=256;nc.height=48;const ng=nc.getContext('2d');ng.font='bold 30px Arial';ng.textAlign='center';ng.lineWidth=5;ng.strokeStyle='#000';ng.fillStyle='#fff';ng.strokeText(name,128,34);ng.fillText(name,128,34);
  const tg=new THREE.Sprite(new THREE.SpriteMaterial({map:new THREE.CanvasTexture(nc),transparent:true,depthTest:false}));tg.scale.set(5,.94,1);tg.position.y=6.6;g.add(tg);
  return g;}
function addLog(name,msg){const p=document.createElement('p'),n=document.createElement('b');n.textContent='['+name+']: ';n.style.color=nameCol(name);p.append(n,msg);$('log').appendChild(p);while($('log').children.length>7)$('log').firstChild.remove();}
function mpSay(v){if(mp.room)mp.room.presence({msg:v,mt:Date.now()}).catch(()=>{});}
function mpTick(t,w,dt){
  if(!mp.room)return;const ps=mp.room.peers();
  if(t-mp.last>.066){mp.last=t;const p={n:$('un').textContent,x:+P.x.toFixed(2),y:+P.y.toFixed(2),z:+P.z.toFixed(2),f:+P.face.toFixed(2),w:w?1:0,g:P.ground?1:0,c:P.coins,m:mapName};const s=JSON.stringify(av);if(s!==mp.avs){mp.avs=s;p.av=av;}mp.room.presence(p).catch(()=>{});}
  if(mp.adopt){const o=ps.find(q=>!q.sameTab&&q.presence.m);if(o){mp.adopt=false;if(maps[o.presence.m]&&o.presence.m!==mapName)setMap(o.presence.m);}}
  const seen=new Set();
  for(const q of ps){if(q.sameTab)continue;const d=q.presence;if(!Number.isFinite(d.x)||!Number.isFinite(d.y)||!Number.isFinite(d.z))continue;
    seen.add(q.peer);const a=cleanAv(d.av),as=JSON.stringify(a),nm=String(d.n||'Player').slice(0,16);let r=mp.R.get(q.peer);
    if(!r||r.as!==as||r.nm!==nm){const old=r;if(old)scene.remove(old.g);r={g:mkAvatar(a,nm),as,nm,mt:old?old.mt:(d.mt||0),ph:old?old.ph:0,b:null,be:0};r.g.position.set(d.x,d.y,d.z);scene.add(r.g);mp.R.set(q.peer,r);}
    const g=r.g;g.visible=d.m===mapName;
    g.position.x+=(d.x-g.position.x)*.3;g.position.y+=(d.y-g.position.y)*.3;g.position.z+=(d.z-g.position.z)*.3;
    if(Number.isFinite(d.f)){let da=d.f-g.rotation.y;da=Math.atan2(Math.sin(da),Math.cos(da));g.rotation.y+=da*.3;}
    const air=!d.g,wk=d.w&&d.g;r.ph+=dt*(wk?12:0);const s=wk?Math.sin(r.ph):0;
    g.aL.rotation.x=air?Math.PI:-s*.9;g.aR.rotation.x=air?Math.PI:s*.9;g.lL.rotation.x=s*.9;g.lR.rotation.x=-s*.9;
    if(d.mt&&d.mt!==r.mt){r.mt=d.mt;const msg=String(d.msg||'').slice(0,100);if(msg){addLog(nm,msg);if(r.b)g.remove(r.b);r.b=bubbleSprite(msg);r.b.position.y=7.2+r.b.scale.y/2;r.be=t+6;g.add(r.b);}}
    if(r.b&&t>r.be){g.remove(r.b);r.b=null;}
  }
  for(const [id,r] of mp.R)if(!seen.has(id)){scene.remove(r.g);mp.R.delete(id);}
  if(t-mp.lb>.5){mp.lb=t;const box=$('lbr');box.textContent='';let n=1;for(const q of ps){if(q.sameTab)continue;n++;const d=q.presence,row=document.createElement('div'),a=document.createElement('span'),b=document.createElement('span');a.textContent=String(d.n||'Player').slice(0,16);b.textContent=String(Number.isFinite(d.c)?d.c:0);row.append(a,b);box.appendChild(row);}$('mpm').textContent=(mp.room===mp.lobby?'Global server':'Server '+mp.code)+' · '+n+' online';}
}
async function mpLeave(){try{if(mp.room&&mp.room!==mp.lobby)await mp.room.leave();}catch(_){}mp.room=mp.lobby;mp.code='GLOBAL';mp.avs='';mp.R.forEach(r=>scene.remove(r.g));mp.R.clear();$('lbr').textContent='';mpUI();}
async function mpEnter(code,create){
  if(mp.room)await mpLeave();
  let ns=null;try{ns=window.claude&&await window.claude.use('room');}catch(_){}if(ns)mp.lobby=ns;
  if(!ns){setMps('Multiplayer isn’t available here. Open this page signed in to Claude with access to it.');return;}
  setMps('Connecting…');
  try{
    const room=await ns.join('rz-'+code.toLowerCase());mp.room=room;mp.code=code;mp.avs='';mp.last=0;
    if(create){if(mapName==='studio')setMap('base');setMps('Server created! Code: '+code+' – friends enter it and press Join.');}
    else{const t0=Date.now();while(Date.now()-t0<3000&&!room.peers().some(q=>!q.sameTab))await new Promise(r=>setTimeout(r,150));
      if(!room.peers().some(q=>!q.sameTab)){await mpLeave();setMps('No running server has that code.');return;}
      mp.adopt=true;setMps('Joined server '+code+'!');}
    mpUI();
  }catch(e){mp.room=mp.lobby;mp.code='GLOBAL';mp.avs='';setMps('Could not connect: '+((e&&e.message)||'unknown error'));mpUI();}
}
$('mpc').onclick=()=>{const CH='ABCDEFGHJKMNPQRSTUVWXYZ23456789';mpEnter(Array.from({length:5},()=>CH[Math.floor(Math.random()*CH.length)]).join(''),true);};
$('mpjb').onclick=()=>{const c=$('mpj').value.trim().toUpperCase().replace(/[^A-Z0-9]/g,'');if(c.length<4){setMps('Enter a server code first.');return;}mpEnter(c,false);};
$('mpj').addEventListener('keydown',e=>{if(e.key==='Enter')$('mpjb').click();});
$('mpl').onclick=()=>{mpLeave();setMps(mp.lobby?'Back in the Global server.':'You left the server.');};
