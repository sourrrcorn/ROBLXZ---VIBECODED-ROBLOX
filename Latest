  const l=Math.hypot(A.d.x,A.d.z)||1,ux=A.d.x/l,uz=A.d.z/l;
  if(m[1]==='beam'){const n=p.n||1;for(let k=0;k<n;k++){const d=n>1?A.d.clone().add(new V3((Math.random()-.5)*.5,(Math.random()-.5)*.25,(Math.random()-.5)*.5)).normalize():A.d;shoot({o:A.o,d},col,p.d,p.fx,p.w||.3);}}
  else if(m[1]==='fist'){beam(A.o,A.o.clone().addScaledVector(A.d,p.r),col,.7);for(const d of liveD()){const dx=d.g.position.x-P.x,dz=d.g.position.z-P.z,dist=Math.hypot(dx,dz);if(dist<p.r+2&&(dx*ux+dz*uz)/Math.max(dist,.01)>.55){hurtD(d,p.d,ux,uz,p.kb||15);if(p.fx)fxD(d,p.fx);}}}
  else if(m[1]==='dash'){gm.ex=ux*120;gm.ez=uz*120;burst(new V3(P.x,P.y+3,P.z),col,16,18);for(const d of liveD()){const dx=d.g.position.x-P.x,dz=d.g.position.z-P.z;if(Math.hypot(dx,dz)<p.dist&&(dx*ux+dz*uz)>0)hurtD(d,p.d,ux,uz,12);}}
  else if(m[1]==='aoe'){boomFx(new V3(P.x,P.y+1,P.z),p.r,col);beep(120,.3,'sawtooth',.1,40);for(const d of liveD()){const dx=d.g.position.x-P.x,dz=d.g.position.z-P.z,dist=Math.hypot(dx,dz);if(dist<p.r){const k=Math.sign(p.kb||1)||1;hurtD(d,p.d,dx/(dist||1)*k,dz/(dist||1)*k,Math.abs(p.kb||12));if(p.fx)fxD(d,p.fx);}}}
  else{rc.set(A.o,A.d);const h=rc.intersectObjects(maps[mapName].g.children.filter(c=>c.isMesh),false)[0];let end=A.o.clone().addScaledVector(A.d,h?Math.min(h.distance,70):70);
    for(const d of liveD()){const c=new V3(d.g.position.x,d.g.position.y+2.5,d.g.position.z),tt=c.clone().sub(A.o).dot(A.d);if(tt>0&&tt<70&&A.o.clone().addScaledVector(A.d,tt).distanceTo(c)<2.2){end=c;break;}}
    beam(A.o,end,col,.5);boomFx(end,p.r,col);beep(100,.35,'sawtooth',.1,35);
    for(const d of liveD()){const dx=d.g.position.x-end.x,dz=d.g.position.z-end.z,dist=Math.hypot(dx,dz);if(dist<p.r){const k=Math.sign(p.kb||1)||1;hurtD(d,p.d,dx/(dist||1)*k,dz/(dist||1)*k,Math.abs(p.kb||20));if(p.fx)fxD(d,p.fx);}}}}
function punch(){const now=nowS();if(now<(gm.cd.p||0))return;gm.cd.p=now+.4;const A=aim(lm);P.face=Math.atan2(A.d.x,A.d.z);melee({d:9,r:5.5,f:''},A,now);}
