  if(sl&&playing)P.face=yaw+Math.PI;let nx=P.x+dx*dt;if(boxes.some(b=>overlap(nx,P.y,P.z,b)))nx=P.x;P.x=nx;
  let nz=P.z+dz*dt;if(boxes.some(b=>overlap(P.x,P.y,nz,b)))nz=P.z;P.z=nz;
  if(keys.Space&&(P.ground||(C.inf&&!jh))){P.vy=C.jump;P.ground=false;}jh=!!keys.Space;
  if(C.fly)P.vy=((keys.Space?1:0)-(keys.ShiftLeft||keys.ShiftRight?1:0))*C.speed;else P.vy-=C.grav*dt;P.y+=P.vy*dt;P.ground=false;
  for(const b of boxes)if(overlap(P.x,P.y,P.z,b)){
    if(P.vy<=0){P.y=b.y1;P.ground=true;}else P.y=b.y0-H-.01;P.vy=0;}
  if(P.y<killY)reset();
  {const mm=maps[mapName];
  if(mm.cp&&P.ground)for(const c of mm.cp)if(Math.abs(P.x-c[0])<7&&Math.abs(P.z-c[2])<7&&Math.abs(P.y-c[1])<1.5&&P.cp!==c){P.cp=c;toast('Checkpoint!');}
