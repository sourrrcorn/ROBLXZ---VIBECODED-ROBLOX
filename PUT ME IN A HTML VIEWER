#log{max-height:130px;overflow:hidden;padding:6px 10px;font-size:14px}
#log p{margin:2px 0}
#msg{width:100%;border:0;background:rgba(0,0,0,.55);color:#fff;padding:7px 10px;font:inherit;box-sizing:border-box;outline:none}
