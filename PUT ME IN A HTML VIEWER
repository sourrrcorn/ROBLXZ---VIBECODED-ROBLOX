#cheat label span{float:right;color:#00a2ff;font-weight:700}
#cheat input[type=range]{width:100%;margin:2px 0 0}
#cheat .t{display:flex;align-items:center;gap:8px;font-size:15px}
#cheat .bt{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-top:8px}
#cheat .bt button{padding:8px 4px;border:0;border-radius:4px;background:#3a3a3a;color:#fff;font:inherit;font-size:13px;cursor:pointer}
#cheat .bt button:hover{background:#00a2ff}
#cbtn{height:42px;margin-left:6px;padding:0 14px;border:0;border-radius:4px;background:var(--panel);color:#fff;font:inherit;font-weight:700;cursor:pointer}
#ed{display:none;position:fixed;left:12px;top:50%;transform:translateY(-50%);width:min(250px,60vw);background:rgba(25,25,25,.9);border-radius:8px;padding:14px;max-height:88vh;overflow:auto}
#home.edit .card{display:none}#home.edit #ed{display:block}
#home.edit{background:linear-gradient(90deg,rgba(10,20,40,.7),rgba(10,20,40,.05))}
#ed h3{margin:0 0 4px;font-size:20px}#ed h4{margin:10px 0 5px;font-size:12px;letter-spacing:1px;opacity:.7}
.sw,.ch{display:flex;flex-wrap:wrap;gap:5px}
.sw i{width:24px;height:24px;border-radius:4px;border:2px solid transparent;cursor:pointer}.sw i.on{border-color:#fff}
.ch b{padding:5px 9px;background:#3a3a3a;border-radius:4px;cursor:pointer;font-weight:600;font-size:13px}.ch b.on{background:#00a2ff}
#avb,#done{width:100%;padding:11px;border:0;border-radius:4px;color:#fff;font:inherit;font-size:18px;font-weight:700;cursor:pointer}
#avb{background:#444;margin-bottom:10px}#done{background:#00b06f;margin-top:14px}
#leave{margin-left:10px;background:#c0392b;color:#fff;border:0;border-radius:3px;padding:3px 10px;font:inherit;cursor:pointer}
</style></head><body>
<div id="home"><div id="ed"></div><div class="card"><div class="tag">2019 REVIVAL</div><h1>Baseplate</h1><p>Classic blocky 3D. Jump around, collect coins and climb the obby.</p><input id="name" maxlength="16" placeholder="Username" value="Builderman_Fan"><button id="avb">Avatar</button><button id="play">▶ Play</button><small>WASD · Space · Right-drag to look · Enter to chat</small></div></div>
<div class="ui" id="top"><button id="mbtn" title="Menu">≡</button><button id="cbtn">Cheats</button></div><div id="menu"><h2>Menu</h2><button id="resume">Resume Game</button><button id="resetc">Reset Character</button><button id="leave">Leave Game</button></div>
