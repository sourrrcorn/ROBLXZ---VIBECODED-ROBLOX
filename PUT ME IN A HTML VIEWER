<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
const $=id=>document.getElementById(id);
const renderer=new THREE.WebGLRenderer({antialias:true});
renderer.setSize(innerWidth,innerHeight);renderer.shadowMap.enabled=true;renderer.shadowMap.type=THREE.PCFShadowMap;
document.body.appendChild(renderer.domElement);
const scene=new THREE.Scene();scene.background=new THREE.Color(0xcfe6f7);
const cam=new THREE.PerspectiveCamera(70,innerWidth/innerHeight,.3,5000);
scene.add(new THREE.HemisphereLight(0xffffff,0x8a8a8a,.95));
const sun=new THREE.DirectionalLight(0xffffff,.8);sun.position.set(40,70,30);sun.castShadow=true;
sun.shadow.mapSize.set(2048,2048);const sc=sun.shadow.camera;sc.left=sc.bottom=-50;sc.right=sc.top=50;sc.far=200;
scene.add(sun,sun.target);
// ---- 2019 sky: gradient dome, sun, clouds ----
const sunDir=new THREE.Vector3(40,70,30).normalize();
const skyC=document.createElement('canvas');skyC.width=4;skyC.height=256;
{const g=skyC.getContext('2d'),gr=g.createLinearGradient(0,0,0,256);gr.addColorStop(0,'#3d7fd4');gr.addColorStop(.5,'#cfe6f7');gr.addColorStop(1,'#cfe6f7');g.fillStyle=gr;g.fillRect(0,0,4,256);}
const dome=new THREE.Mesh(new THREE.SphereGeometry(2500,24,16),new THREE.MeshBasicMaterial({map:new THREE.CanvasTexture(skyC),side:THREE.BackSide,depthWrite:false}));dome.renderOrder=-2;scene.add(dome);
function blob(stops){const c=document.createElement('canvas');c.width=c.height=128;const g=c.getContext('2d'),r=g.createRadialGradient(64,64,0,64,64,64);stops.forEach(([o,col])=>r.addColorStop(o,col));g.fillStyle=r;g.fillRect(0,0,128,128);return new THREE.CanvasTexture(c);}
const sunSp=new THREE.Sprite(new THREE.SpriteMaterial({map:blob([[0,'#ffffff'],[.12,'#fffbe0'],[.35,'rgba(255,240,180,.3)'],[1,'rgba(255,240,180,0)']]),depthWrite:false}));sunSp.scale.set(700,700,1);scene.add(sunSp);
const cloudTex=blob([[0,'rgba(255,255,255,.95)'],[.55,'rgba(255,255,255,.55)'],[1,'rgba(255,255,255,0)']]);
for(let i=0;i<28;i++){const a=Math.random()*6.28,r=300+Math.random()*1500,bx=Math.cos(a)*r,bz=Math.sin(a)*r,by=200+Math.random()*120;
  for(let j=0;j<5;j++){const s=new THREE.Sprite(new THREE.SpriteMaterial({map:cloudTex,depthWrite:false,opacity:.9}));const w=120+Math.random()*110;s.scale.set(w,w*.45,1);s.position.set(bx+(j-2)*60+Math.random()*30,by+Math.random()*14,bz+Math.random()*30);scene.add(s);}}
function nameCol(s){let h=0;for(const c of s)h=(h*31+c.charCodeAt(0))%360;return 'hsl('+h+',75%,68%)';}

// ---- stud textures & parts ----
const studCache={},sideCache={};
function studTex(col){
  if(studCache[col])return studCache[col];
  const c=document.createElement('canvas');c.width=c.height=64;const g=c.getContext('2d');
  g.fillStyle='#'+col.toString(16).padStart(6,'0');g.fillRect(0,0,64,64);
  g.fillStyle='rgba(0,0,0,.22)';g.beginPath();g.arc(32,35,17,0,7);g.fill();
  g.fillStyle='rgba(255,255,255,.3)';g.beginPath();g.arc(32,32,16,0,7);g.fill();
  g.fillStyle='rgba(255,255,255,.12)';g.beginPath();g.arc(32,32,11,0,7);g.fill();
  g.strokeStyle='rgba(0,0,0,.25)';g.strokeRect(0,0,64,64);
  const t=new THREE.CanvasTexture(c);t.wrapS=t.wrapT=THREE.RepeatWrapping;return studCache[col]=t;
}
const boxes=[];
function part(cx,top,cz,w,h,d,col){
  const side=sideCache[col]||(sideCache[col]=new THREE.MeshLambertMaterial({color:col}));
  const tt=studTex(col).clone();tt.needsUpdate=true;tt.repeat.set(w,d);tt.anisotropy=8;
  const m=new THREE.Mesh(new THREE.BoxGeometry(w,h,d),[side,side,new THREE.MeshLambertMaterial({map:tt}),side,side,side]);
  m.position.set(cx,top-h/2,cz);m.castShadow=m.receiveShadow=true;scene.add(m);
  boxes.push({x0:cx-w/2,x1:cx+w/2,z0:cz-d/2,z1:cz+d/2,y0:top-h,y1:top});return m;
}
part(0,0,0,2048,4,2048,0xa3a2a5);                     // baseplate
part(0,1,0,12,1,12,0x8d8d8f);                     // spawn
// pyramid near spawn
for(let i=0;i<4;i++)part(-26,3*(i+1),-12,16-i*4,3,16-i*4,[0xe03a3a,0xf5a623,0xf5e03a,0x3ab4e0][i]);
// obby staircase
const coins=[];
for(let i=0;i<9;i++){
  const top=3*(i+1),z=-14-i*9;
  part(i%2?24:16,top,z,8,2,6,new THREE.Color().setHSL(i/9,.7,.5).getHex());
  coins.push([i%2?24:16,top+2.5,z]);
}
part(20,30,-104,28,3,28,0xffcc00);                 // top platform
coins.push([20,33,-104],[15,33,-104],[25,33,-104]);
part(40,10,10,10,10,10,0x6c4bd1);part(52,5,18,10,5,10,0xd14b9a); // blocks
for(let a=0;a<8;a++){const r=20;coins.push([Math.cos(a*.785)*r,2,Math.sin(a*.785)*r+10]);}
const coinMeshes=coins.map(p=>{
  const m=new THREE.Mesh(new THREE.CylinderGeometry(1,1,.25,20),new THREE.MeshLambertMaterial({color:0xffd23a,emissive:0x6a5000}));
  m.rotation.x=Math.PI/2;const g=new THREE.Group();g.add(m);g.position.set(...p);scene.add(g);return g;
});
// ---- character ----
const player=new THREE.Group();scene.add(player);
const mat=c=>new THREE.MeshLambertMaterial({color:c});
function limb(w,h,d,c,px,py){
  const piv=new THREE.Group();piv.position.set(px,py,0);
  const m=new THREE.Mesh(new THREE.BoxGeometry(w,h,d),mat(c));m.position.y=-h/2;m.castShadow=true;piv.add(m);player.add(piv);return piv;
}
const fc=document.createElement('canvas');fc.width=fc.height=64;const fg=fc.getContext('2d');
fg.fillStyle='#f5cd30';fg.fillRect(0,0,64,64);fg.fillStyle='#111';fg.fillRect(18,20,6,10);fg.fillRect(40,20,6,10);
fg.strokeStyle='#111';fg.lineWidth=3;fg.beginPath();fg.arc(32,34,13,.25,Math.PI-.25);fg.stroke();
const ys=mat(0xf5cd30);
const head=new THREE.Mesh(new THREE.CylinderGeometry(.62,.62,1.1,28),ys);const faceTex=new THREE.CanvasTexture(fc);const faceM=new THREE.Mesh(new THREE.PlaneGeometry(1.05,1.05),new THREE.MeshBasicMaterial({map:faceTex,transparent:true}));faceM.position.z=.625;head.add(faceM);
head.scale.set(1,1,1);head.position.y=4.5;head.castShadow=true;
head.position.y=4.55;player.add(head);
const torso=new THREE.Mesh(new THREE.BoxGeometry(2,2,1),mat(0x0d69ac));torso.position.y=3;torso.castShadow=true;player.add(torso);
const armL=limb(1,2,1,0xf5cd30,-1.5,4),armR=limb(1,2,1,0xf5cd30,1.5,4);
const legL=limb(1,2,1,0xa4bd47,-.5,2),legR=limb(1,2,1,0xa4bd47,.5,2);
// ---- avatar + bubble ----
const av={head:0xf5cd30,torso:0x0d69ac,arms:0xf5cd30,legs:0xa4bd47,face:0,hat:0};
const hatG=new THREE.Group();hatG.position.y=5.1;player.add(hatG);

function hex(c){return '#'+c.toString(16).padStart(6,'0');}
function applyAv(){
  head.material.color.setHex(av.head);
  fg.clearRect(0,0,64,64);fg.fillStyle='#111';fg.strokeStyle='#111';fg.lineWidth=3;
  const f=av.face,arc=(x,y,r,a,b)=>{fg.beginPath();fg.arc(x,y,r,a,b);fg.stroke();};
  if(f===1){fg.fillRect(8,18,48,12);arc(32,36,12,.3,Math.PI-.3);}
  else if(f===2){fg.fillRect(17,26,7,8);fg.fillRect(40,26,7,8);fg.beginPath();fg.moveTo(12,15);fg.lineTo(26,23);fg.moveTo(52,15);fg.lineTo(38,23);fg.stroke();arc(32,52,11,Math.PI+.4,Math.PI*2-.4);}
  else if(f===3){fg.fillStyle='#fff';[[20,26,10],[43,28,7]].forEach(([x,y,r])=>{fg.beginPath();fg.arc(x,y,r,0,7);fg.fill();fg.stroke();});fg.fillStyle='#111';fg.fillRect(22,28,4,4);fg.fillRect(40,30,4,4);arc(32,42,10,.2,Math.PI-.2);fg.fillStyle='#e05a7a';fg.fillRect(36,48,8,9);}
  else{fg.fillRect(18,20,6,10);fg.fillRect(40,20,6,10);arc(32,34,13,.25,Math.PI-.25);}
  faceTex.needsUpdate=true;
  torso.material.color.setHex(av.torso);
  [armL,armR].forEach(a=>a.children[0].material.color.setHex(av.arms));
  [legL,legR].forEach(a=>a.children[0].material.color.setHex(av.legs));
  while(hatG.children.length)hatG.remove(hatG.children[0]);
  const add=(w,h,d,c,x,y,z)=>{const m=new THREE.Mesh(new THREE.BoxGeometry(w,h,d),mat(c));m.position.set(x,y,z);m.castShadow=true;hatG.add(m);};
  if(av.hat===1){add(1.3,.45,1.3,0xc4281c,0,.22,0);add(1.3,.1,.6,0xc4281c,0,.05,.85);}
  if(av.hat===2){add(1.9,.12,1.9,0x111111,0,.06,0);add(1.2,1.2,1.2,0x111111,0,.7,0);add(1.22,.25,1.22,0xc4281c,0,.3,0);}
  if(av.hat===3){add(1.3,.5,1.3,0xffd23a,0,.25,0);[[-.5,-.5],[.5,-.5],[-.5,.5],[.5,.5]].forEach(([x,z])=>add(.25,.4,.25,0xffd23a,x,.7,z));}
}
let bub=null;
function showBubble(txt){
  if(bub){player.remove(bub);bub.material.map.dispose();}
  const c=document.createElement('canvas'),g=c.getContext('2d');c.width=512;g.font='bold 34px Arial';
  const lines=[];let cur='';
  for(const w of txt.split(' ')){const tt=cur?cur+' '+w:w;if(g.measureText(tt).width>440&&cur){lines.push(cur);cur=w;}else cur=tt;}
  lines.push(cur);const h=lines.length*44+30;c.height=h+30;
  g.font='bold 34px Arial';g.fillStyle='#fff';g.strokeStyle='#222';g.lineWidth=5;
  g.beginPath();g.moveTo(28,6);g.arcTo(506,6,506,h+6,22);g.arcTo(506,h+6,6,h+6,22);g.arcTo(6,h+6,6,6,22);g.arcTo(6,6,506,6,22);g.closePath();g.fill();g.stroke();
  g.fillRect(238,h+2,36,8);g.beginPath();g.moveTo(238,h+8);g.lineTo(256,h+26);g.lineTo(274,h+8);g.fill();g.stroke();g.fillStyle='#fff';g.fillRect(240,h+2,32,8);
  g.fillStyle='#111';g.textAlign='center';lines.forEach((l,i)=>g.fillText(l,256,50+i*44));
  const sp=new THREE.Sprite(new THREE.SpriteMaterial({map:new THREE.CanvasTexture(c),transparent:true,depthTest:false}));
  sp.scale.set(7,7*c.height/512,1);sp.position.y=6.4+sp.scale.y/2;sp.exp=clock.elapsedTime+6;player.add(sp);bub=sp;
}
// ---- state ----
const P={x:0,y:3,z:6,vy:0,ground:false,face:0,coins:0};
let playing=false,editing=false;let yaw=0,pitch=.35,dist=16;const keys={};let drag=false,typing=false;
const HW=.8,H=5;
function overlap(x,y,z,b){if(C.noclip)return false;return x+HW>b.x0&&x-HW<b.x1&&z+HW>b.z0&&z-HW<b.z1&&y+H>b.y0+.001&&y<b.y1-.001;}
function reset(){P.x=0;P.y=3;P.z=6;P.vy=0;}
addEventListener('keydown',e=>{
  if(!playing)return;if(typing){if(e.key==='Escape'){$('msg').blur();}return;}if(e.key==='Escape'){$('menu').classList.toggle('open');return;}if(e.code==='F2'||e.code==='Backquote'){e.preventDefault();$('cheat').classList.toggle('open');return;}
  if(e.key==='Enter'||e.key==='/'){e.preventDefault();$('msg').focus();return;}
  keys[e.code]=true;if(e.code==='KeyR')reset();if(e.code==='Space')e.preventDefault();
});
addEventListener('keyup',e=>keys[e.code]=false);
$('msg').addEventListener('focus',()=>{typing=true;for(const k in keys)keys[k]=false;});
$('msg').addEventListener('blur',()=>typing=false);
$('msg').addEventListener('keydown',e=>{
  if(e.key==='Enter'){const v=e.target.value.trim();if(v){const p=document.createElement('p');const n=document.createElement('b');n.textContent='['+$('un').textContent+']: ';n.style.color=nameCol($('un').textContent);p.append(n,v);$('log').appendChild(p);showBubble(v);
    while($('log').children.length>7)$('log').firstChild.remove();}e.target.value='';e.target.blur();}
});
const cv=renderer.domElement;
cv.addEventListener('pointerdown',e=>{if(e.button!==2&&e.pointerType==='mouse')return;drag=true;cv.setPointerCapture(e.pointerId);});
cv.addEventListener('pointerup',()=>drag=false);
cv.addEventListener('contextmenu',e=>e.preventDefault());
cv.addEventListener('pointermove',e=>{if(!drag)return;yaw-=e.movementX*.006;pitch=Math.max(-.2,Math.min(1.4,pitch+e.movementY*.006));});
cv.addEventListener('wheel',e=>{dist=Math.max(4,Math.min(40,dist+e.deltaY*.02));},{passive:true});
addEventListener('resize',()=>{renderer.setSize(innerWidth,innerHeight);cam.aspect=innerWidth/innerHeight;cam.updateProjectionMatrix();});
// ---- loop ----
const clock=new THREE.Clock();let walk=0;
function tick(){
  requestAnimationFrame(tick);
  const dt=Math.min(clock.getDelta(),.05),t=clock.elapsedTime;if(!playing){if(editing)P.face+=dt*.9;else yaw+=dt*.12;}
  let ix=(keys.KeyD||keys.ArrowRight?1:0)-(keys.KeyA||keys.ArrowLeft?1:0);
  let iz=(keys.KeyS||keys.ArrowDown?1:0)-(keys.KeyW||keys.ArrowUp?1:0);
  const moving=ix||iz;let dx=0,dz=0;
  if(moving){const l=Math.hypot(ix,iz);ix/=l;iz/=l;
    dx=(ix*Math.cos(yaw)+iz*Math.sin(yaw))*C.speed;dz=(-ix*Math.sin(yaw)+iz*Math.cos(yaw))*C.speed;
    let ta=Math.atan2(dx,dz),da=ta-P.face;da=Math.atan2(Math.sin(da),Math.cos(da));P.face+=da*Math.min(1,dt*14);}
  let nx=P.x+dx*dt;if(boxes.some(b=>overlap(nx,P.y,P.z,b)))nx=P.x;P.x=nx;
  let nz=P.z+dz*dt;if(boxes.some(b=>overlap(P.x,P.y,nz,b)))nz=P.z;P.z=nz;
  if(keys.Space&&(P.ground||(C.inf&&!jh))){P.vy=C.jump;P.ground=false;}jh=!!keys.Space;
  if(C.fly)P.vy=((keys.Space?1:0)-(keys.ShiftLeft||keys.ShiftRight?1:0))*C.speed;else P.vy-=C.grav*dt;P.y+=P.vy*dt;P.ground=false;
  for(const b of boxes)if(overlap(P.x,P.y,P.z,b)){
    if(P.vy<=0){P.y=b.y1;P.ground=true;}else P.y=b.y0-H-.01;P.vy=0;}
  if(P.y<-60)reset();
  // animation
  walk+=dt*(moving&&P.ground?12:0);const s=moving&&P.ground?Math.sin(walk):0;
  legL.rotation.x=s*.9;legR.rotation.x=-s*.9;armL.rotation.x=-s*.9;armR.rotation.x=s*.9;
  if(!P.ground){armL.rotation.z=-2.6+3;armR.rotation.z=2.6-3;armL.rotation.x=armR.rotation.x=Math.PI;}else{armL.rotation.z=armR.rotation.z=0;}
  player.position.set(P.x,P.y,P.z);player.rotation.y=P.face;if(bub&&t>bub.exp){player.remove(bub);bub=null;}
  // coins
  coinMeshes.forEach(c=>{if(!c.visible)return;c.rotation.y=t*3;
    if(Math.hypot(c.position.x-P.x,c.position.z-P.z)<2.2&&c.position.y>P.y-1&&c.position.y<P.y+H+1){c.visible=false;P.coins++;$('cc').textContent=P.coins;}});
  // camera
  const tx=P.x,ty=P.y+3,tz=P.z;
  cam.position.set(tx+Math.sin(yaw)*Math.cos(pitch)*dist,ty+Math.sin(pitch)*dist,tz+Math.cos(yaw)*Math.cos(pitch)*dist);
  cam.lookAt(tx,ty,tz);dome.position.copy(cam.position);sunSp.position.copy(cam.position).addScaledVector(sunDir,2200);
  sun.position.set(tx+40,70,tz+30);sun.target.position.set(tx,0,tz);
  renderer.render(scene,cam);
}
