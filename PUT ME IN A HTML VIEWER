#menu button:hover{background:#444}
#log b{font-weight:700}
#log{text-shadow:0 1px 2px #000}
#cheat{display:none;right:8px;top:calc(env(safe-area-inset-top,0px) + 100px);width:min(240px,70vw);padding:12px;background:rgba(20,20,20,.9);max-height:70vh;overflow:auto}
body.play #cheat.open{display:block}
#cheat h3{margin:0 0 8px;font-size:18px;color:#ff5c5c}
