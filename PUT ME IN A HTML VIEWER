html{scroll-padding-top:env(safe-area-inset-top,0px)}
html,body{height:100%;margin:0;overflow:hidden;background:#000;color:var(--tx);font-family:"Source Sans 3","Source Sans Pro",Arial,sans-serif}
canvas{display:block;width:100%;height:100%}
.ui{position:fixed;background:var(--panel);border-radius:4px;font-size:15px}
#top{top:calc(env(safe-area-inset-top,0px) + 8px);left:8px;padding:8px 14px;font-weight:700;letter-spacing:.5px}
